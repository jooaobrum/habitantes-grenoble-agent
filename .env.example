# ── Secrets ──────────────────────────────────────────────────────────────────
# Required: OpenRouter API Key — powers all chat/completions (agent, ingestion
# synthesis, the Suggestions pipeline's Jev filter / extraction / merge / labels,
# eval judge). Default model is "google/gemini-2.5-flash-lite"; swap
# via config (llm.model_name / MODEL_NAME), e.g. "openai/gpt-4o-mini",
# "anthropic/claude-3.5-haiku".
OPENROUTER_API_KEY=sk-or-...

# Required: OpenAI API Key — embeddings only (text-embedding-3-small), for both the
# Q&A and the Suggestions collections (ingestion and queries). OpenRouter has no
# embeddings endpoint, so retrieval still runs on OpenAI.
OPENAI_API_KEY=sk-...

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: Tavily API key — powers the Grenoble-scoped web search tool (a
# secondary source for factual/current/generalist info, fact-checking, and the
# fallback when the Q&A or Suggestions collection has no answer). Leave unset to
# disable web search entirely — the agent simply won't offer the tool (no crash,
# knowledge-base-only behavior; a recommendation with no Suggestion found then
# just says nothing was recommended).
#
# Not env vars: the Suggestions collection name and tuning live in
# config/base.yaml (`suggestions:`); the opt-out list is config/suggestion_exclusions.txt.
# Standalone ingestion scripts (incl. `make suggestions`) also read QDRANT_URL and
# QDRANT_API_KEY if you set them.
TAVILY_API_KEY=tvly-...

# Required for the WhatsApp Cloud API channel: salt used to hash the sender's
# phone number into chat_id. The raw number is never sent past this hash —
# chat_id = sha256(salt + number). Use a long random string (e.g. `openssl
# rand -hex 32`). Env-only, never in yaml.
WHATSAPP_ID_SALT=change-me-to-a-long-random-string

# ── WhatsApp Cloud API (official channel) ─────────────────────────────────────
# All optional — a missing value disables the channel rather than crashing API
# startup (see WhatsAppCloudConfig.enabled in config.py). Required once you're
# ready to receive/send WhatsApp messages via the webhook.
#
# Required: System User permanent access token (NOT the 24h token from the API
# Setup panel — that one expires). Business Settings → System Users → add a
# system user → Generate token, scopes: whatsapp_business_messaging,
# whatsapp_business_management, business_management.
WHATSAPP_BUSINESS_TOKEN=change-me
# Required: from the app's WhatsApp → API Setup panel.
WHATSAPP_PHONE_NUMBER_ID=change-me
# Optional: only needed for number/template management calls, not messaging.
WHATSAPP_WABA_ID=change-me
# Required: App Settings → Basic → App Secret. Used to verify the
# X-Hub-Signature-256 header on every inbound webhook call — without it, anyone
# who finds the webhook URL could inject fake messages into the agent.
WHATSAPP_APP_SECRET=change-me
# Required: a value YOU invent (e.g. `openssl rand -hex 32`) and paste into the
# Meta webhook config panel. Meta echoes it back on the GET handshake to prove
# it's really Meta configuring the webhook.
WHATSAPP_VERIFY_TOKEN=change-me

# Required to expose the webhook publicly: token for the docker-compose
# `cloudflared` service. Cloudflare Zero Trust dashboard → Networks → Tunnels
# → create a named tunnel → copy its token here. Not read by the Python app —
# consumed directly by the cloudflared container (docker-compose.yml).
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Required: shared secret for the Control Center's /admin/* routes (dashboard
# and the Telegram bot's heartbeat both send this as X-Admin-Token).
ADMIN_TOKEN=change-me

# Optional: Control Center alert email config. Leave unset to disable email
# sending (alerts still log and disable the switch — fail-safe by design).
# Gmail note: SMTP_FROM must match SMTP_USER (or a verified "Send mail as"
# alias) or Gmail delivers to Archive instead of the Inbox. Avoid EMAIL_TO ==
# SMTP_USER — self-addressed SMTP mail is also skipped to Archive by Gmail.
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
